# ---------------------------------------------------------------------------
# EARTHFLIGHT environment configuration.  Copy to .env.local and edit.
# Everything works with NO keys (NASA GIBS + EOX Sentinel-2 cloudless + Re:Earth terrain
# + OpenFreeMap/OSM buildings).  Keys only upgrade quality. See docs/DATA_SOURCES.md.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Imagery provider for ground detail:
#   eox      (default, keyless)  Sentinel-2 cloudless 2016, 10 m/px, CC BY 4.0 -> commercial OK w/ attribution
#            (only EOX's 2016 and 2017 mosaics are CC BY 4.0; 2018+ are CC BY-NC-SA = NOT for commercial sites)
#   esri     Esri World Imagery (sub-meter in cities). Public endpoint is NOT licensed for commercial sites;
#            set ARCGIS key below and review Esri terms before launching commercially.
#   maptiler MapTiler satellite (needs NEXT_PUBLIC_MAPTILER_KEY, paid plan for commercial use)
#   ion      Cesium ion Bing Aerial (needs NEXT_PUBLIC_CESIUM_ION_TOKEN, commercial plan required)
NEXT_PUBLIC_IMAGERY=eox

# Optional keys (all are public/browser keys: restrict them by HTTP referrer in the provider dashboard!)
NEXT_PUBLIC_CESIUM_ION_TOKEN=
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_ARCGIS_API_KEY=

# Terrain: "reearth" (keyless, CC BY 4.0) or "ion" (Cesium World Terrain, needs ion token)
NEXT_PUBLIC_TERRAIN=reearth

# Optional self-hosted / commercial geocoder for worldwide search (Nominatim-compatible /search API).
# The public nominatim.openstreetmap.org default is rate-limited to 1 req/s: fine for a demo only.
# GEOCODER_URL=

# Google AdSense publisher id, e.g. ca-pub-1234567890123456. Ads render ONLY on content pages, never on /explore.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=

# Contact e-mail displayed on privacy/terms pages.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
